# Runtime state. Everything the harness records about *you* lives here and is
# intentionally never committed. See docs/privacy.md.
var/

# Local secrets (never commit). Prefer environment variables.
secrets.json

# HumanEval playground (vendored dataset + scratch work dirs)
humaneval/

# Training artifacts
*.gguf
*.safetensors
adapters/
outbox/

# Node / editor
node_modules/
dist/
.DS_Store
*.log
.venv/
__pycache__/
*.pyc

# The benchmark suite ships deliberate fixtures that the rules above would otherwise
# swallow — a server log, and a build/ tree that exists precisely so a task can ask for
# it to be ignored. Without these negations a fresh clone silently loses task data.
!bench/suite/**/workspace/app.log
!bench/suite/**/workspace/build/
!bench/suite/**/workspace/build/**
